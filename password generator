import random
import string

print("===================================")
print("       PASSWORD GENERATOR")
print("===================================")

while True:
    try:
        length = int(input("\nEnter password length (minimum 6): "))

        if length < 6:
            print("Password length must be at least 6.")
            continue

        break

    except ValueError:
        print("Please enter a valid number.")

# Character options
characters = string.ascii_lowercase

if input("Include uppercase letters? (y/n): ").lower() == "y":
    characters += string.ascii_uppercase

if input("Include numbers? (y/n): ").lower() == "y":
    characters += string.digits

if input("Include special characters? (y/n): ").lower() == "y":
    characters += string.punctuation

# Generate password
password = ''.join(random.choice(characters) for _ in range(length))

print("\n===================================")
print("Generated Password:", password)
print("===================================")

# Password strength
if length >= 12 and any(c.isupper() for c in password) \
        and any(c.isdigit() for c in password) \
        and any(c in string.punctuation for c in password):
    strength = "Strong"
elif length >= 8:
    strength = "Medium"
else:
    strength = "Weak"

print("Password Strength:", strength)
